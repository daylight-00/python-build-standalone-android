{
  "schema_version": 1,
  "lock_kind": "cpython-source-build-input",
  "target": {
    "triple": "aarch64-linux-android",
    "build_option": "default",
    "arch": "aarch64",
    "abi": "arm64-v8a",
    "libc": "bionic",
    "android_api": 34,
    "android_api_source": "the last API level whose Bionic additions reach CPython's AC_CHECK_FUNCS list"
  },
  "python": {
    "implementation": "cpython",
    "version": "3.14.8",
    "major_minor": "3.14"
  },
  "source_archive": {
    "filename": "Python-3.14.8.tar.xz",
    "url": "https://www.python.org/ftp/python/3.14.8/Python-3.14.8.tar.xz",
    "size_bytes": 24130644,
    "sha256": "c2215904f02b175596dc49351585104f4bc20341e1c47378b26a2c274360ce73"
  },
  "build_flow": {
    "driver": "Android/android.py",
    "dependency_lock": "config/source/dependency-recipes.lock.json",
    "dependency_producer": "beeware/cpython-android-source-deps",
    "dependency_binding": "the exact release assets pinned by CPython 3.14.8 Android/unpack_deps"
  },
  "runtime_data_defaults": {
    "openssldir": "/data/data/com.termux/files/usr/etc/tls",
    "tzpath": "/data/data/com.termux/files/usr/share/zoneinfo",
    "runtime_overridable": [
      "SSL_CERT_FILE",
      "SSL_CERT_DIR",
      "PYTHONTZPATH"
    ]
  }
}
